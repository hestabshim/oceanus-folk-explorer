---
import MesurerOverlay from '../components/MesurerOverlay';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Oceanus Folk — Graph Explorer</title>
  <link rel="stylesheet" href={`${import.meta.env.BASE_URL}/styles.css`} />
</head>
<body>
  <div class="explorer" data-view="influence">
    <header class="topbar">
      <a class="brand" href="#" aria-label="Oceanus Folk graph explorer">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span><strong>OCEANUS</strong><small>FOLK GRAPH</small></span>
      </a>
      <nav class="view-switcher" aria-label="Graph views">
        <button class="view-tab active" data-view="influence">Influence</button>
        <button class="view-tab" data-view="careers">Careers</button>
        <button class="view-tab" data-view="candidates">Candidates</button>
      </nav>
      <div class="top-actions"><span class="dataset-label">VAST 2025 · MC1</span><button class="button primary" id="exportButton">Export</button></div>
    </header>

    <div class="workspace">
      <main class="stage">
        <div class="stage-header">
          <h1 id="viewTitle" data-views="influence candidates">Influence by year</h1>
          <div class="artist-search" id="artistSearchBox" data-views="careers"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input id="artistSearch" type="text" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="artistSearchMenu" aria-label="Search artists" autocomplete="off" /><button class="slot-clear" id="clearArtist" aria-label="Clear artist" hidden>×</button><div class="slot-menu" id="artistSearchMenu" role="listbox" hidden></div></div>
          <p id="viewDescription"></p>
        </div>
        <div class="toolbar" aria-label="Filters">
          <div class="filter-group" data-views="influence"><span class="filter-label">Direction</span><div class="segmented" role="group" aria-label="Influence direction"><button class="segment active" data-direction="outbound" title="Other genres referencing Oceanus Folk">Outward</button><button class="segment" data-direction="inbound" title="Oceanus Folk referencing other genres">Inward</button></div></div>
          <div class="filter-group" data-views="candidates"><label class="filter-label" for="compareMetric">Compare by</label><select id="compareMetric"><option value="releases">Releases</option><option value="notable">Notable releases</option><option value="folk">Oceanus Folk releases</option><option value="influenced">Artists they influenced</option><option value="influences">Artists who influenced them</option><option value="notoriety">Notoriety</option></select></div>
          <div class="filter-group" data-views="candidates"><span class="filter-label">Count</span><div class="segmented" role="group" aria-label="Count mode"><button class="segment active" data-cumulative="true">Cumulative</button><button class="segment" data-cumulative="false">Per year</button></div></div>
          <div class="filter-group years" data-views="influence candidates"><div class="filter-label-row"><span class="filter-label">Years</span><output id="yearOutput"></output></div><div class="range-wrap"><span class="range-fill" id="yearFill"></span><input id="yearStart" type="range" aria-label="Start year" /><input id="yearEnd" type="range" aria-label="End year" /></div><div class="range-labels"><span id="yearMin"></span><span id="yearMax"></span></div></div>
          <div class="filter-group" data-views="influence careers"><span class="filter-label">Relationship types</span><div class="chip-list" id="typeFilters"></div></div>
          <div class="filter-group" data-views="careers"><span class="filter-label">Search</span><label class="check-row"><input type="checkbox" id="folkOnly" /> Oceanus Folk artists only</label></div>
          <div class="filter-group" data-views="candidates"><span class="filter-label">Artist pool</span><div class="segmented" role="group" aria-label="Artist pool"><button class="segment active" data-pool="all">All</button><button class="segment" data-pool="rising" title="First release in 2030 or later">Rising</button><button class="segment" data-pool="established" title="First release before 2030">Established</button></div></div>
          <div class="filter-group" data-views="candidates"><label class="filter-label" for="poolSort">Sort search by</label><select id="poolSort"><option value="notoriety">Notoriety</option><option value="newest">Newest debut</option></select></div>
          <button class="clear-button" id="clearFilters">Clear filters</button>
        </div>
        <div class="compare-slots" id="compareSlots" data-views="candidates" aria-label="Artists to compare"></div>
        <div class="chart-shell"><div class="axis-title" id="axisTitle"></div><div id="viz" class="viz" aria-live="polite"></div><div class="legend" id="legend"></div></div>
        <div class="chart-hint" id="chartHint"></div>
      </main>

      <aside class="inspector" aria-label="Selection details">
        <div class="inspector-header"><h2 id="inspectorTitle">Details</h2><span class="inspector-state" id="inspectorState">IDLE</span></div>
        <div id="inspectorContent" class="inspector-content"><div class="empty-inspector"><span class="empty-mark">+</span><h2>Select a mark</h2><p>Select a year, line, or candidate to view details.</p></div></div>
      </aside>
    </div>
  </div>
  <div class="tooltip" id="tooltip" role="status"></div>
  <script is:inline src={`${import.meta.env.BASE_URL}/graph-data.js`}></script>
  <script is:inline src={`${import.meta.env.BASE_URL}/app.js`}></script>
  <MesurerOverlay client:only="react" />
</body>
</html>
